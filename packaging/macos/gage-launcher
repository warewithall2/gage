#!/bin/sh
# Route B app process. On quit, stop only the lan/ui/watch processes this
# launcher started; any service that was already running is left alone.
set -u

APP_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GAGE_BIN=${GAGE_BIN:-$APP_DIR/gage}

# Match src/identity.rs exactly: first non-whitespace GAGE_HOME,
# COUNTERSIGN_HOME or CTX_HOME, then first existing home in order.
nonblank() {
  [ -n "$(printf '%s' "$1" | tr -d '[:space:]')" ]
}
if nonblank "${GAGE_HOME:-}"; then
  RESOLVED_HOME=$GAGE_HOME
elif nonblank "${COUNTERSIGN_HOME:-}"; then
  RESOLVED_HOME=$COUNTERSIGN_HOME
elif nonblank "${CTX_HOME:-}"; then
  RESOLVED_HOME=$CTX_HOME
elif [ -d "$HOME/.gage" ]; then
  RESOLVED_HOME=$HOME/.gage
elif [ -d "$HOME/.countersign" ]; then
  RESOLVED_HOME=$HOME/.countersign
elif [ -d "$HOME/.ctx" ]; then
  RESOLVED_HOME=$HOME/.ctx
else
  RESOLVED_HOME=$HOME/.gage
fi
export GAGE_HOME=$RESOLVED_HOME

STARTED=""
cleanup() {
  trap - EXIT HUP INT TERM
  for pid in $STARTED; do
    kill "$pid" 2>/dev/null || :
  done
  for pid in $STARTED; do
    wait "$pid" 2>/dev/null || :
  done
}
trap cleanup EXIT
trap 'exit 0' HUP INT TERM

# Does this PID resolve to the home this launcher selected? Services started
# by Gage inherit GAGE_HOME; older invocations may use a compatibility
# variable or only HOME. Read the live process environment so a same-named
# process for another identity is never adopted.
process_has_home() {
  pid=$1
  if [ "${GAGE_FORCE_PS_ENV:-0}" != 1 ] && [ -r "/proc/$pid/environ" ]; then
    environment=$(tr '\000' ' ' < "/proc/$pid/environ" 2>/dev/null) || return 1
  else
    # On Darwin, `-o command=` suppresses the environment appended by `e`.
    # Keep the default format so GAGE_HOME and HOME remain visible in `eww`.
    environment=$(ps eww -p "$pid" 2>/dev/null) || return 1
  fi

  env_has_var() {
    case " $environment " in *" $1="*) return 0;; *) return 1;; esac
  }
  env_has_value() {
    case " $environment " in *" $1=$2 "*) return 0;; *) return 1;; esac
  }

  for variable in GAGE_HOME COUNTERSIGN_HOME CTX_HOME; do
    if env_has_var "$variable"; then
      env_has_value "$variable" "$RESOLVED_HOME"
      return $?
    fi
  done
  if env_has_value HOME "$HOME"; then
    if [ -d "$HOME/.gage" ]; then
      process_home=$HOME/.gage
    elif [ -d "$HOME/.countersign" ]; then
      process_home=$HOME/.countersign
    elif [ -d "$HOME/.ctx" ]; then
      process_home=$HOME/.ctx
    else
      process_home=$HOME/.gage
    fi
    [ "$process_home" = "$RESOLVED_HOME" ]
    return $?
  fi
  return 1
}

service_pids() {
  service=$1
  bin_name=${GAGE_BIN##*/}
  if command -v pgrep >/dev/null 2>&1; then
    pgrep -f "(^|/)${bin_name} ${service}([[:space:]]|$)" 2>/dev/null || :
  else
    ps -axo pid=,command= 2>/dev/null | awk -v re="(^|/)${bin_name} ${service}([[:space:]]|$)" '$0 ~ re {print $1}'
  fi
}

service_running() {
  service=$1
  for pid in $(service_pids "$service"); do
    if process_has_home "$pid"; then
      return 0
    fi
  done
  return 1
}

start_service() {
  service=$1
  shift
  if service_running "$service"; then
    echo "gage $service already running; adopting it" >&2
  else
    "$GAGE_BIN" "$service" "$@" >/dev/null 2>&1 &
    STARTED="$STARTED $!"
  fi
}

start_service lan
start_service ui
start_service watch --every 120

ui_port=${GAGE_UI_PORT:-7777}
timeout=${GAGE_START_TIMEOUT:-30}
elapsed=0
ui_state_matches_home() {
  state=$(curl -fsS --max-time 1 "http://127.0.0.1:$ui_port/api/state" 2>/dev/null) || return 1
  printf '%s\n' "$state" | grep -F "\"home\":\"$RESOLVED_HOME\"" >/dev/null
}
while [ "$elapsed" -lt "$timeout" ]; do
  if ui_state_matches_home; then
    break
  fi
  sleep 1
  elapsed=$((elapsed + 1))
done
if ! ui_state_matches_home; then
  echo "Gage could not start: the UI at http://127.0.0.1:$ui_port did not report the selected home within ${timeout}s; refusing to open another home's UI." >&2
  echo "Check whether another application is using port $ui_port, then try again." >&2
  exit 1
fi

if [ -n "${GAGE_OPEN:-}" ]; then
  "$GAGE_OPEN" "http://127.0.0.1:$ui_port/"
else
  open "http://127.0.0.1:$ui_port/"
fi

# Keep the app process alive until macOS quits it. The EXIT trap owns cleanup.
while :; do sleep 1 & wait "$!" || :; done
